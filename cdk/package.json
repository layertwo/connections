{
    "name": "flight-map-cdk",
    "version": "1.0.0",
    "description": "CDK infrastructure for flight map static website",
    "main": "bin/app.js",
    "scripts": {
        "build": "tsc",
        "cdk": "cdk",
        "check-format": "eslint lib package.json eslint.config.mjs .prettierrc.mjs",
        "clean": "find lib \\( -name \"*.d.ts\" -o -name \"*.js\" \\) -delete",
        "format": "npm run check-format -- --fix",
        "test": "jest",
        "watch": "tsc -w"
    },
    "dependencies": {
        "aws-cdk": "^2.1033.0",
        "aws-cdk-lib": "^2.273.0",
        "constructs": "^10.4.2",
        "env-var": "^7.0.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin-js": "^4.0.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "*",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^30.0.4",
        "prettier": "^3.8.4",
        "prettier-plugin-pkgsort": "^0.3.0",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.0"
    },
    "overrides": {
        "baseline-browser-mapping": "^2.11.0",
        "brace-expansion@^1.0.0": "^1.1.21",
        "brace-expansion@^2.0.0": "^2.1.7",
        "brace-expansion@^5.0.0": "^5.0.12",
        "browserslist": "^4.28.7",
        "handlebars": "^4.7.10",
        "js-yaml": "^5.0.0"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true
    }
}
